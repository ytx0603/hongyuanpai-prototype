  "hard_prohibitions": [
    {
      "id": "H001",
      "desc": "铜器不得使用含氯清洗剂",
      "material": [
        "METAL_CU"
      ],
      "forbidden": [
        "Cl-",
        "HCl",
        "NaCl",
        "NH4Cl"
      ],
      "rationale": "氯离子催化青铜病循环反应 CuCl->Cu2(OH)3Cl",
      "source": "[K] WW/T 0009-2007"
    },
    {
      "id": "H002",
      "desc": "铁器不得使用酸性除锈剂",
      "material": [
        "METAL_FE"
      ],
      "forbidden": [
        "H2SO4",
        "HCl",
        "HNO3",
        "H3PO4>10%"
      ],
      "rationale": "酸洗加速晶间腐蚀,破坏金相组织",
      "source": "[K] WW/T 0010-2008"
    },
    {
      "id": "H003",
      "desc": "陶瓷补全禁用化学合成染料",
      "material": [
        "CERAMIC"
      ],
      "forbidden": [
        "有机染料",
        "化学颜料"
      ],
      "allowed": "矿物颜料(赭石/朱砂/石青/石绿/钴蓝/钛白)",
