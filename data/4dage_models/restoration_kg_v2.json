      "rationale": "甲醛与木质素不可逆交联",
      "source": "[I] 木质文物规范"
    },
    {
      "id": "H005",
      "desc": "纸质文物禁用化学漂白剂",
      "material": [
        "PAPER"
      ],
      "forbidden": [
        "NaClO",
        "H2O2>1%",
        "KMnO4"
