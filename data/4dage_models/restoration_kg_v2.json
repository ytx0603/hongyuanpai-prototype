      "source": "[K] 古陶瓷修复行业共识"
    },
    {
      "id": "H004",
      "desc": "竹木器禁用含甲醛防腐剂",
      "material": [
        "WOOD"
      ],
      "forbidden": [
        "HCHO",
        "甲醛",
        "戊二醛>2%"
